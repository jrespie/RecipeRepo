{
  "name": "recipe-repo",
  "version": "0.1.0",
  "private": true,
  "description": "Local-first meal planning and shopping list app for home use.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace @recipe-repo/web",
    "dev:api": "npm run dev --workspace @recipe-repo/api",
    "db:up": "docker compose up -d",
    "db:down": "docker compose down",
    "db:logs": "docker compose logs -f postgres",
    "db:generate": "npm run prisma:generate --workspace @recipe-repo/db",
    "db:migrate": "npm run prisma:migrate --workspace @recipe-repo/db",
    "db:seed": "npm run prisma:seed --workspace @recipe-repo/db",
    "build": "npm run build --workspaces",
    "lint": "npm run lint --workspaces",
    "test": "npm run test --workspaces"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
